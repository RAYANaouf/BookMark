// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  binaryTargets = ["debian-openssl-3.0.x", "windows"]
}



datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}




model Account {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  hash      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user      User?
}




model User{
  id Int @id @default(autoincrement())
  accountId Int 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  firstName String  @default("")
  lastName  String  @default("")
  profilePhoto String? @default("")


  isStudent    Boolean @default(false)
  isParent     Boolean @default(false)
  isTeacher    Boolean @default(false)
  isSuperAdmin Boolean @default(false)
  
  superAdmin   SuperAdmin?


  account Account @relation(fields: [accountId], references: [id])
  @@unique([accountId])

  academyLinks UserAcademy[]
}


model SuperAdmin{
  id Int @id @default(autoincrement())
  userId Int 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User @relation(fields: [userId], references: [id])
  @@unique([userId])
}



model TrainingProgram {
  id                Int      @id @default(autoincrement())
  name              String
  description       String
  coverPhoto        String?
  targetAudience    String?    // ===> "Beginners", "High School Students" ...
  prerequisites     String?    // ===>"Basic HTML knowledge", comma-separated or markdown
  whatYouWillLearn  String?    // ===> markdown or bullet text
  whatYouCanDoAfter String?    // outcomes: "Build full apps" , create some thing , work on some companies ..., etc.

  minAge Int?
  maxAge Int?

  price       Float    @default(0.0)
  enabled     Boolean  @default(true)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt


  academyId   Int 
  academy     Academy @relation(fields: [academyId] , references: [id])

  // Relations
  groups      Group[] // people who bought/joined it (organized into study groups)
}


model Post {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  photo       String?   
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  // Relations
  academyId   Int
  academy     Academy @relation(fields: [academyId], references: [id])
}



model Module{
  id      Int @id @default(autoincrement())
  name    String
  year    Int
  branch  String
  type    String

  academies Academy[]

  groups Group[]
}




model Support{
  id      Int @id @default(autoincrement())
  title   String
  url     String
  type    String
  seances Seance[]
}

model Seance{
  id     Int @id @default(autoincrement())
  date   DateTime
  start  DateTime
  end    DateTime


  groupId Int
  group Group @relation(fields: [groupId], references: [id])

  supports Support[]
}

model Group{
  id     Int @id @default(autoincrement())
  name   String

  moduleId Int
  module Module @relation(fields: [moduleId], references: [id])

  seances  Seance[]
  exams    Exam[]


  trainingProgramId Int?
  trainingProgram TrainingProgram? @relation(fields: [trainingProgramId] , references: [id]) 

}

model Exam{
  id       Int @id @default(autoincrement())
  name     String
  date     DateTime
  duration Int

  groupId  Int
  group    Group @relation(fields: [groupId], references: [id])
}












model UserAcademy{
  userId  Int
  academyId Int
  role String? //admin , owner , employee...
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields : [userId] , references : [id])
  academy Academy @relation(fields: [academyId] , references: [id])

  @@id([userId , academyId])
}










model Academy{
  id         Int @id @default(autoincrement())
  name       String
  logo       String?
  phone      String?
  email      String?

  modules Module[]
  userLinks UserAcademy[]
  trainingPrograms TrainingProgram[]
  posts Post[]
}

